<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notifikasi lokal chat (worker WorkManager) — runtime permission di Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Fitur "Properti terdekat": coarse one-shot, tidak disimpan/dikirim ke server -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.LapakHunian.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.LapakHunian.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Links: share link properti dibuka langsung di app (autoVerify → tanpa dialog) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="lapakhunian.com"
                    android:pathPrefix="/properti/"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- FCM push notification (pes chat/lead baru walau app ditutup) -->
        <service
            android:name=".core.notifications.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
            <!-- Payload notification dari server tampil di tray lewat channel ini saat app
                 background; harus sama dengan LocalNotifier.CHANNEL_CHAT (heads-up). -->
            <meta-data
                android:name="com.google.firebase.messaging.default_notification_channel_id"
                android:value="chat_heads_up" />
            <meta-data
                android:name="com.google.firebase.messaging.default_notification_icon"
                android:resource="@drawable/ic_launcher_foreground_logo" />
        </service>

        <!-- Ambil foto kamera di wizard: hasil disimpan lewat FileProvider (cache) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.lapakhunian.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
