<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LapakHunian" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash: background putih polos (icon transparan) — brand splash dalam app
         yang tampil setelahnya, logo lama di system splash dihapus -->
    <style name="Theme.LapakHunian.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.LapakHunian</item>
    </style>
</resources>
