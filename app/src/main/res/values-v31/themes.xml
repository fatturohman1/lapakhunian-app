<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash API 31+: background putih polos (icon transparan) — brand splash
         dalam app yang tampil setelahnya, logo lama di system splash dihapus. -->
    <style name="Theme.LapakHunian.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.LapakHunian</item>
    </style>
</resources>
