<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash API 31+: sistem memulai AVD sendiri → logo + loader arc berputar (900ms/putaran).
         Viewport persegi menjaga konten tetap utuh di lingkaran mask splash. -->
    <style name="Theme.LapakHunian.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/lapakhunian_loading</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.LapakHunian</item>
    </style>
</resources>
